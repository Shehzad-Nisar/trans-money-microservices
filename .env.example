# ============================================================
# .env.example — TransMoney Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file.
# ============================================================

# ── JWT Secret ────────────────────────────────────────────
# Must be a long, random, base64-encoded or alphanumeric string.
# Both api-gateway and auth-service MUST share the same secret.
# Generate one: openssl rand -hex 64
JWT_SECRET=your_very_long_and_random_jwt_secret_here

# ── MySQL / Database ──────────────────────────────────────
MYSQL_ROOT_PASSWORD=your_strong_root_password
MYSQL_USER=banking
MYSQL_PASSWORD=your_strong_db_password
MYSQL_DATABASE=banking

# ── Auth Service DB ───────────────────────────────────────
AUTH_DB_URL=jdbc:mysql://localhost:3306/banking
AUTH_DB_USERNAME=banking
AUTH_DB_PASSWORD=your_strong_db_password

# ── Account Service DB ────────────────────────────────────
ACCOUNT_DB_URL=jdbc:mysql://localhost:3306/account_db?createDatabaseIfNotExist=true
ACCOUNT_DB_USERNAME=root
ACCOUNT_DB_PASSWORD=your_strong_root_password

# ── Transaction Service DB ────────────────────────────────
TRANSACTION_DB_URL=jdbc:mysql://localhost:3306/transaction_db?createDatabaseIfNotExist=true
TRANSACTION_DB_USERNAME=root
TRANSACTION_DB_PASSWORD=your_strong_root_password

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Kafka ─────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Frontend ──────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080
